{
  "name": "robots-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "test": "node --test tests/core/*.test.ts tests/harness/*.test.ts tests/packages/*.test.ts packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "browser:harness": "node scripts/harness-server.ts",
    "typecheck:packages": "node scripts/typecheck-packages.ts",
    "test:isolated": "node --test tests/packages/isolated.test.ts",
    "game:dev": "node scripts/game-server.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.15",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "three": "0.186.1"
  },
  "dependencies": {
    "@robots/system-api": "0.1.0",
    "@robots/values": "0.1.0",
    "@robots/protocol": "0.1.0",
    "@robots/runtime": "0.1.0",
    "@robots/navigation": "0.1.0",
    "@robots/presentation": "0.1.0",
    "@robots/presentation-three": "0.1.0",
    "@robots/content": "0.1.0",
    "@robots/application-host": "0.1.0",
    "@robots/damage": "0.1.0",
    "@robots/weapons": "0.1.0",
    "@robots/perception": "0.1.0",
    "@robots/decision": "0.1.0",
    "@robots/battle": "0.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
